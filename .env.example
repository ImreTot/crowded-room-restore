# Required for the API and Alembic inside Docker Compose.
# For a host-side connection, replace database with localhost.
DATABASE_URL=postgresql+asyncpg://app:app@database:5432/app

# Required for the Telegram bot. Obtain a token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Required by the worker for audio transcription through the OpenAI API.
OPENAI_API_KEY=

# Shared bearer token for the bot, API and worker. Generate a random value locally.
INTERNAL_API_TOKEN=

# Kafka address inside Docker Compose. Used by the API and worker.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
